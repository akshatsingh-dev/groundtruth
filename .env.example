# Mireye — sign up at https://www.mireye.com/account with code BUILD
MIREYE_API_KEY=
MIREYE_BASE_URL=https://api.mireye.com

# The agent's reasoning loop. Pick ONE.
#
# Preferred: a long-lived OAuth token from your existing Claude subscription.
# Generate it with `claude setup-token` in a terminal. No API billing.
# The planner uses the Claude Agent SDK on this path.
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative: a pay-as-you-go Anthropic API key. The planner uses the Messages
# API on this path. Same tools, same trace output.
ANTHROPIC_API_KEY=

# CourtListener — free key at https://www.courtlistener.com/help/api/rest/
COURTLISTENER_TOKEN=
