__pycache__/
*.py[cod]
.venv/
venv/
.env
data/cache.sqlite
data/cache.sqlite-*
data/raw/
# ...except the Census cartographic boundaries the map is drawn from. Same reason
# as county_index.json: `python -m sweep.map` on a fresh clone otherwise fails on
# a TLS error instead of drawing a map. 3.9 MB.
!data/raw/cb_county_5m.zip
!data/raw/cb_state_5m.zip
outputs/*.json
outputs/*.html
!outputs/drafts/

# The national map is a deliverable — the demo video ends on it, so a judge
# cloning the repo must get it without running the sweep first.
!outputs/county_map.html

# The full sweep output carries the trigger detail text for every county and is
# ~7 MB. data/county_scores.slim.json is committed instead; regenerate the full
# file with `python3 -m sweep.counties`.
data/county_scores.json

# county_index.json IS committed. Without it a clean clone cannot run the sweep
# at all: it has to pull the Census gazetteer, which needs network and working
# TLS roots, and a judge on a fresh machine gets a cert error instead of a map.
.DS_Store
.pytest_cache/
data/county_scores.progress.jsonl
.venv/
